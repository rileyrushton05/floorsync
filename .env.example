POSTGRES_DB=floorsync
POSTGRES_USER=floorsync
POSTGRES_PASSWORD=floorsync
POSTGRES_HOST_PORT=5433
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=human
DATABASE_URL=postgresql+asyncpg://floorsync:floorsync@postgres:5432/floorsync
DATABASE_SYNC_URL=postgresql+psycopg://floorsync:floorsync@postgres:5432/floorsync
REDIS_URL=redis://redis:6379/0
# Prefix of the live-update pub/sub channel; change it if environments share one Redis.
LIVE_UPDATE_CHANNEL_PREFIX=floorsync.live
CELERY_BROKER_URL=redis://redis:6379/1
API_HOST_PORT=8002
NEXT_PUBLIC_API_URL=http://localhost:8002
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["Accept","Authorization","Content-Type","X-Request-ID"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","api"]
MAX_REQUEST_BODY_BYTES=1048576
TRUST_REQUEST_ID_HEADER=false
READINESS_TIMEOUT_SECONDS=1.0
# Development-only key. Generate a unique 32+ character value before deployment.
JWT_SECRET_KEY=development-only-change-this-jwt-secret-key
JWT_ISSUER=floorsync-api
JWT_AUDIENCE=floorsync-frontend
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
