# Copy to /opt/floorsync/.env.production on the Droplet and replace every
# placeholder. This file is deliberately not used by local development.
POSTGRES_DB=floorsync
POSTGRES_USER=floorsync
POSTGRES_PASSWORD=replace-with-a-long-random-password

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql+asyncpg://floorsync:replace-with-a-url-encoded-password@postgres:5432/floorsync
DATABASE_SYNC_URL=postgresql+psycopg://floorsync:replace-with-a-url-encoded-password@postgres:5432/floorsync
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

NEXT_PUBLIC_API_URL=http://<DROPLET_IP>
CORS_ALLOWED_ORIGINS=["http://<DROPLET_IP>"]
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["Accept","Authorization","Content-Type","X-Request-ID"]
ALLOWED_HOSTS=["<DROPLET_IP>"]
MAX_REQUEST_BODY_BYTES=1048576
TRUST_REQUEST_ID_HEADER=true
READINESS_TIMEOUT_SECONDS=1.0

JWT_SECRET_KEY=replace-with-a-unique-32-character-or-longer-secret
JWT_ISSUER=floorsync-api
JWT_AUDIENCE=floorsync-frontend
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
