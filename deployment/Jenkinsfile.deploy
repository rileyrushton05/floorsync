// Configure a separate Jenkins Multibranch Pipeline to use this script.
// Only discover the main branch for that job. The SSH credential must be
// folder-scoped to this deployment job and unavailable to the PR CI job.
pipeline {
  agent { label 'deploy' }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Deploy tested main commit') {
      when {
        branch 'main'
      }
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'floorsync-deploy-key',
            keyFileVariable: 'DEPLOY_KEY',
            usernameVariable: 'DEPLOY_USER'
          )
        ]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail
            mkdir -p ~/.ssh
            ssh-keyscan -H host.docker.internal >> ~/.ssh/known_hosts
            chmod 600 "$DEPLOY_KEY"
            ssh -i "$DEPLOY_KEY" "$DEPLOY_USER"@host.docker.internal "deploy $GIT_COMMIT"
          '''
        }
      }
    }
  }
}
