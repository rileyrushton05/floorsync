er"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1020" y="1375" /></Array></mxGeometry></mxCell><mxCell id="operator" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="120" width="200" height="150" /></mxCell><mxCell id="operator-glyph" value="" style="shape=umlActor;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="322.0" y="120" width="56" height="106" /></mxCell><mxCell id="operator-name" value="Machine Operator" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;align=left;verticalAlign=middle;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="233" width="200" height="30" /></mxCell><mxCell id="manager" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="120" width="200" height="150" /></mxCell><mxCell id="manager-glyph" value="" style="shape=umlActor;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1022.0" y="120" width="56" height="106" /></mxCell><mxCell id="manager-name" value="Manager" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;align=left;verticalAlign=middle;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="233" width="200" height="30" /></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:23px&quot;&gt;Web Application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[Container: React + Next.js]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Operator: current operation, upcoming queue and shift plan&lt;br&gt;Manager: jobs, machines, schedule planning and simulation playback&lt;br&gt;Animates playback locally; reloads authoritative state through REST" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry as="