<mxfile host="app.diagrams.net" type="device"><diagram name="FloorSync — Event-Sourced Playback" id="floorsync-event-sourced-playback"><mxGraphModel dx="1400" dy="1480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1480" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;FloorSync — Event-Sourced Playback&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="1280" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Persisted control history → authoritative server position → local browser animation" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="1280" height="32" as="geometry" /></mxCell><mxCell id="group0" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#777777;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="70" y="125" width="1260" height="335" as="geometry" /></mxCell><mxCell id="group-label0" value="&lt;b&gt;Control recording · atomic commit&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="90" y="417" width="1180" height="30" as="geometry" /></mxCell><mxCell id="group1" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#777777;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="70" y="535" width="1260" height="545" as="geometry" /></mxCell><mxCell id="group-label1" value="&lt;b&gt;Authoritative read path · replay the saved log at server time&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="90" y="1031" width="1180" height="30" as="geometry" /></mxCell><mxCell id="group2" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#777777;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="485" y="1145" width="855" height="280" as="geometry" /></mxCell><mxCell id="group-label2" value="&lt;b&gt;Web Application · Next.js client&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="505" y="1377" width="1180" height="30" as="geometry" /></mxCell><mxCell id="control" value="&lt;b style=&quot;font-size:21px&quot;&gt;Simulation Control API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[FastAPI + shared services]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Validate and serialise controls&lt;br&gt;Record wall-clock event time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="235" width="320" height="155" as="geometry" /></mxCell><mxCell id="events" value="&lt;b style=&quot;font-size:21px&quot;&gt;Simulation Event Log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[PostgreSQL: simulation_events]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Start, pause, resume and speed&lt;br&gt;Seek, reset and complete" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="540" y="235" width="320" height="175" as="geometry" /></mxCell><mxCell id="projection" value="&lt;b style=&quot;font-size:21px&quot;&gt;Readable Projection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[PostgreSQL: simulations]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Status, speed and timestamps&lt;br&gt;Metadata, not clock authority" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="980" y="235" width="320" height="175" as="geometry" /></mxCell><mxCell id="entries" value="&lt;b style=&quot;font-size:21px&quot;&gt;Schedule Entries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[PostgreSQL: schedule_entries]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Stored starts and durations&lt;br&gt;Stable operation assignments" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="320" height="175" as="geometry" /></mxCell><mxCell id="timeline" value="&lt;b style=&quot;font-size:21px&quot;&gt;Timeline Adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[FloorSyncScheduleAdapter]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Translate stored assignments&lt;br&gt;Derive end times and makespan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="540" y="610" width="320" height="175" as="geometry" /></mxCell><mxCell id="replay" value="&lt;b style=&quot;font-size:21px&quot;&gt;Event Replay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[derive_simulated_time]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Accumulate only running intervals&lt;br&gt;Apply speed, pause, seek and reset&lt;br&gt;Clamp position to makespan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="980" y="610" width="320" height="175" as="geometry" /></mxCell><mxCell id="position" value="&lt;b style=&quot;font-size:21px&quot;&gt;Authoritative Position&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[SimulationService / REST]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Position, speed and playback flags&lt;br&gt;Derived at the server read time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="980" y="900" width="320" height="145" as="geometry" /></mxCell><mxCell id="animation" value="&lt;b style=&quot;font-size:21px&quot;&gt;Local Animation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[Browser playback clock]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Advance only while running&lt;br&gt;Use elapsed wall time × speed&lt;br&gt;Seek to fresh server positions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="540" y="1210" width="320" height="160" as="geometry" /></mxCell><mxCell id="dashboard" value="&lt;b style=&quot;font-size:21px&quot;&gt;Dashboard Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[React + Next.js]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Read authoritative REST position&lt;br&gt;Resynchronise local playback" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="980" y="1210" width="320" height="160" as="geometry" /></mxCell><mxCell id="edge0" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.4967741935483871;exitPerimeter=0;entryX=0.0;entryY=0.44;entryPerimeter=0;" edge="1" parent="1" source="control" target="events"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label0" value="Append" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="445.0" y="273" width="70" height="28" as="geometry" /></mxCell><mxCell id="edge1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="control" target="projection"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="175" /><mxPoint x="1140" y="175" /></Array></mxGeometry></mxCell><mxCell id="edge-label1" value="Update readable columns" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="599.0" y="138" width="202" height="28" as="geometry" /></mxCell><mxCell id="edge2" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.42857142857142855;exitPerimeter=0;entryX=0.0;entryY=0.42857142857142855;entryPerimeter=0;" edge="1" parent="1" source="entries" target="timeline"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label2" value="Translate" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="435.0" y="646" width="90" height="28" as="geometry" /></mxCell><mxCell id="edge3" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.42857142857142855;exitPerimeter=0;entryX=0.0;entryY=0.42857142857142855;entryPerimeter=0;" edge="1" parent="1" source="timeline" target="replay"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label3" value="Makespan" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="879.0" y="646" width="82" height="28" as="geometry" /></mxCell><mxCell id="edge4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="events" target="replay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="505" /><mxPoint x="1140" y="505" /></Array></mxGeometry></mxCell><mxCell id="edge-label4" value="Replay in occurred_at order" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="883.0" y="468" width="234" height="28" as="geometry" /></mxCell><mxCell id="edge5" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="replay" target="position"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label5" value="Replay result" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1079.0" y="833" width="122" height="28" as="geometry" /></mxCell><mxCell id="edge6" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="position" target="dashboard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label6" value="REST snapshot" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1079.0" y="1108" width="122" height="28" as="geometry" /></mxCell><mxCell id="edge7" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="dashboard" target="animation"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label7" value="Seek / resync" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="859.0" y="1251" width="122" height="28" as="geometry" /></mxCell><mxCell id="note-title0" value="&lt;b&gt;Playback rules&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="100" y="877" width="760" height="32" as="geometry" /></mxCell><mxCell id="note-body0" value="Paused intervals add no simulated time.&lt;br&gt;Speed changes affect subsequent intervals.&lt;br&gt;Seek sets position; reset rewinds to zero." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="908" width="760" height="78" as="geometry" /></mxCell><mxCell id="note-title1" value="&lt;b&gt;Recovery&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="1192" width="760" height="32" as="geometry" /></mxCell><mxCell id="note-body1" value="Refresh, reconnect and live notifications&lt;br&gt;trigger fresh REST reads.&lt;br&gt;Browser time is never the stored authority." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1223" width="760" height="78" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
