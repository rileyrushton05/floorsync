<mxfile host="app.diagrams.net" type="device"><diagram name="FloorSync — Transactional Outbox" id="floorsync-transactional-outbox"><mxGraphModel dx="1400" dy="1480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1480" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;FloorSync — Transactional Outbox&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=27;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="1280" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="Durable simulation changes · Publish after commit · Retry missed publication" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="1280" height="32" as="geometry" /></mxCell><mxCell id="group0" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;fillColor=none;strokeColor=#777777;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="70" y="135" width="1260" height="385" as="geometry" /></mxCell><mxCell id="group-label0" value="&lt;b&gt;One database transaction · event, projection and notification commit together&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="90" y="467" width="1180" height="30" as="geometry" /></mxCell><mxCell id="control" value="&lt;b style=&quot;font-size:21px&quot;&gt;Simulation Control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[FastAPI + shared services]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Lock row and validate command&lt;br&gt;Update readable state projection" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="130" y="235" width="330" height="155" as="geometry" /></mxCell><mxCell id="events" value="&lt;b style=&quot;font-size:21px&quot;&gt;Simulation Event Log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[PostgreSQL: simulation_events]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Append-only control history&lt;br&gt;Authority for playback time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="550" y="235" width="330" height="175" as="geometry" /></mxCell><mxCell id="outbox" value="&lt;b style=&quot;font-size:21px&quot;&gt;Outbox Table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[PostgreSQL: live_update_outbox]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Versioned notification envelope&lt;br&gt;Sequence + delivery bookkeeping" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="960" y="235" width="330" height="175" as="geometry" /></mxCell><mxCell id="relay" value="&lt;b style=&quot;font-size:21px&quot;&gt;Retry Relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[OutboxRelay]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Claim due unpublished rows&lt;br&gt;Retry with capped backoff&lt;br&gt;Mark published after acceptance" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="130" y="665" width="330" height="170" as="geometry" /></mxCell><mxCell id="publisher" value="&lt;b style=&quot;font-size:21px&quot;&gt;Immediate Publisher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[OutboxPublisher]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Read a committed outbox row&lt;br&gt;Publish to Redis, then mark sent&lt;br&gt;Contain failures after commit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="960" y="665" width="330" height="170" as="geometry" /></mxCell><mxCell id="redis" value="&lt;b style=&quot;font-size:21px&quot;&gt;Event Bus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[Redis pub/sub]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Accept versioned change envelope&lt;br&gt;Fan out to active subscribers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1fa1d2;strokeColor=#1fa1d2;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="550" y="1025" width="330" height="155" as="geometry" /></mxCell><mxCell id="hub" value="&lt;b style=&quot;font-size:21px&quot;&gt;Subscriber and Hub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[API live-update components]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Validate incoming envelopes&lt;br&gt;Notify authorised subscriptions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1462a9;strokeColor=#1462a9;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="960" y="1025" width="330" height="155" as="geometry" /></mxCell><mxCell id="clients" value="&lt;b style=&quot;font-size:21px&quot;&gt;Connected Dashboards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;[React + Next.js]&