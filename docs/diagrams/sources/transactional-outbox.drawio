lvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="124.0" y="1121" width="362" height="28" as="geometry" /></mxCell><mxCell id="edge8" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.4;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="hub" target="clients"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-label8" value="WebSocket notification" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;align=center;fontSize=15;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1228" width="194" height="28" as="geometry" /></mxCell><mxCell id="note-title0" value="&lt;b&gt;Delivery semantics&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="1272" width="760" height="32" as="geometry" /></mxCell><mxCell id="note-body0" value="Rollback writes neither the event nor the outbox notice.&lt;br&gt;A publish / mark race can repeat a notification.&lt;br&gt;Redis acceptance is not a browser delivery acknowledgement." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="1303" width="760" height="78" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
