        },
        {
          "name": "Polish edges",
          "routes": [{ "machine": "Edge Polisher", "duration": 35, "energy": 2.75 }]
        },
        {
          "name": "Temper",
          "routes": [{ "machine": "Tempering Furnace", "duration": 60, "energy": 18 }]
        },
        {
          "name": "Inspect",
          "routes": [{ "machine": "Inspection Bench", "duration": 10 }]
        }
      ]
    },
    {
      "name": "Splashback 900x600",
      "operations": [
        {
          "name": "Cut",
          "routes": [{ "machine": "Cutting Table 2", "duration": 15, "energy": 2.4 }]
        },
        {
          "name": "Polish edges",
          "routes": [{ "machine": "Edge Polisher", "duration": 25, "energy": 2 }]
        }
      ]
    },
    {
      "name": "Laminated door panel",
      "priority": "low",
      "operations": [
        {
          "name": "Cut outer pane",
          "routes": [{ "machine": "Cutting Table 1", "duration": 18 }],
          "after": []
