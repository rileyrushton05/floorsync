        {
          "name": "Cut inner pane",
          "routes": [{ "machine": "Cutting Table 2", "duration": 18 }],
          "after": []
        },
        {
          "name": "Laminate",
          "routes": [{ "machine": "Laminating Press", "duration": 45, "energy": 12.5 }],
          "after": ["Cut outer pane", "Cut inner pane"]
        },
        {
          "name": "Inspect",
          "routes": [{ "machine": "Inspection Bench", "duration": 10 }],
          "after": ["Laminate"]
        }
      ]
    }
  ]
