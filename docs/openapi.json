            "type": "string"
          }
        },
        "required": [
          "schedule_id"
        ],
        "title": "SimulationCreateRequest",
        "type": "object"
      },
      "SimulationEventRequest": {
        "additionalProperties": false,
        "description": "Record one playback control action.\n\n``speed`` is required for ``started``, ``resumed`` and ``speed_changed``, and\nignored otherwise.",
        "properties": {
          "event_type": {
            "$ref": "#/components/schemas/SimulationControl"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          }
        },
        "required": [
          "event_type"
        ],
        "title": "SimulationEventRequest",
        "type": "object"
      },
      "SimulationResponse": {
        "description": "A simulation and the position derived from its event log.\n\n``simulated_time`` is a derived measurement in the schedule's own units, so it\nis a float rather than an exact decimal. ``speed`` mirrors the stored\n``Numeric(5, 2)`` column and stays a decimal.",
        "properties": {
          "derived_at": {
            "format": "date-time",
            "title": "Derived At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_complete": {
            "title": "Is Complete",
            "type": "boolean"
          },
          "is_running": {
            "title": "Is Running",
            "type": "boolean"
          },
          "makespan": {
            "title": "Makespan",
            "type": "integer"
          },
          "schedule_id": {
            "format": "uuid",
            "title": "Schedule Id",
            "type": "string"
          },
          "simulated_time": {
            "title": "Simulated Time",
            "type": "number"
          },
          "speed": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Speed",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SimulationStatus"
          }
        },
        "required": [
          "id",
          "schedule_id",
          "status",
          "speed",
          "simulated_time",
          "makespan",
          "is_running",
          "is_complete",
          "derived_at"
        ],
        "title": "SimulationResponse",
        "type": "object"
      },
      "SimulationStatus": {
        "enum": [
          "not_started",
          "running",
          "paused",
          "complete"
        ],
        "type": "string"
      },
      "TimelineLaneResponse": {
        "description": "A machine lane or job row, identified by key and shown by label.",
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ],
        "title": "TimelineLaneResponse",
        "type": "object"
      },
      "TimelineOperationResponse": {
        "description": "One scheduled operation, ready to draw as a bar.",
        "properties": {
          "end": {
            "title": "End",
            "type": "integer"
          },
          "job_key": {
            "title": "Job Key",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "machine_key": {
            "title": "Machine Key",
            "type": "string"
          },
          "machine_slot": {
            "title": "Machine Slot",
            "type": "integer"
          },
          "start": {
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "job_key",
          "machine_key",
          "label",
          "start",
          "end",
          "machine_slot"
        ],
        "title": "TimelineOperationResponse",
        "type": "object"
      },
      "TimelineResponse": {
        "description": "A schedule resolved onto the clock.\n\nMachines and jobs are listed separately from operations so a renderer can lay\nout lanes and rows without scanning every operation to discover them.\n\nThe payload is immutable for a confirmed schedule: the same entries and\ndependencies always resolve to the same times, so a client may fetch it once\nand animate locally against it.",
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/TimelineLaneResponse"
            },
            "title": "Jobs",
            "type": "array"
          },
          "machines": {
            "items": {
              "$ref": "#/components/schemas/TimelineLaneResponse"
            },
            "title": "Machines",
            "type": "array"
          },
          "makespan": {
            "title": "Makespan",
            "type": "integer"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/TimelineOperationResponse"
            },
            "title": "Operations",
            "type": "array"
          },
          "schedule_id": {
            "format": "uuid",
            "title": "Schedule Id",
            "type": "string"
          }
        },
        "required": [
          "schedule_id",
          "makespan",
          "machines",
          "jobs",
          "operations"
        ],
        "title": "TimelineResponse",
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "manager",
          "operator"
        ],
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
