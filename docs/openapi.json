          "paused",
          "resumed",
          "speed_changed",
          "reset",
          "completed"
        ],
        "type": "string"
      },
      "SimulationCreateRequest": {
        "additionalProperties": false,
        "description": "Create the simulation for a confirmed schedule.",
        "properties": {
          "schedule_id": {
            "format": "uuid",
